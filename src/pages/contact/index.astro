---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MapWidget from "../../components/MapWidget.astro";
import { siteData } from "../../data/site";
---

<BaseLayout title="Contact" description="Contact information for the Abraham Lab.">
  <section class="page-intro page-intro--contact">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <p class="overline">Contact</p>
        <h1><span>Contact the</span><span>Abraham Lab.</span></h1>
        <p>For collaborations, speaking requests, and administrative inquiries.</p>
      </div>
    </div>
  </section>

  <section class="section contact-page">
    <div class="shell contact-page__grid">
      <div class="contact-page__details reveal">
        <section class="contact-block contact-block--person">
          <p class="overline">Principal investigator</p>
          <h2>Jonathan Abraham</h2>
          <p>Scientific correspondence and speaking requests.</p>
          <a href={`mailto:${siteData.contact.email}`}>{siteData.contact.email}</a>
        </section>
        <section class="contact-block contact-block--person">
          <p class="overline">Laboratory operations</p>
          <h2>James Spencer</h2>
          <p>Administrative and operational inquiries.</p>
          <a href={`mailto:${siteData.contact.managerEmail}`}>{siteData.contact.managerEmail}</a>
        </section>
        <section class="contact-block contact-block--address">
          <p class="overline">Address</p>
          <address>
            {siteData.contact.addressLines.map((line) => <span>{line}</span>)}
          </address>
        </section>
      </div>
      <MapWidget mode="contact" eyebrow="Campus location" />
    </div>

    <div class="shell contact-page__affiliations reveal">
      <p class="overline">Affiliations</p>
      <div>
        {siteData.affiliations.map((affiliation) => (
          <a class="arrow-link" href={affiliation.href} target="_blank" rel="noreferrer"><span>{affiliation.shortName ?? affiliation.name}</span><span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
