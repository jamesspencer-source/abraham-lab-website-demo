---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/content";
---

<BaseLayout title="Research" description="Published work from the Abraham Lab." canonicalPath="/publications/" noIndex={true}>
  <section class="legacy-page">
    <div class="narrow-shell legacy-page__inner reveal">
      <p class="overline">Research</p>
      <h1>See the publication record.</h1>
      <p>The Publications page lists papers from the lab.</p>
      <a class="button button--primary" href={withBase("/publications/")}>View publications</a>
    </div>
  </section>
</BaseLayout>
