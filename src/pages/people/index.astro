---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/content";

const destination = withBase("/team/");
---

<BaseLayout
  title="Team"
  description="Current members and alumni of the Abraham Lab."
  canonicalPath="/team/"
  noIndex={true}
  redirectTo="/team/"
>
  <section class="legacy-page">
    <div class="narrow-shell legacy-page__inner reveal">
      <p class="overline">Team</p>
      <h1>The lab directory has moved.</h1>
      <p>View current members and alumni on the Team page.</p>
      <a class="button button--primary" href={destination}>View the team</a>
    </div>
  </section>
</BaseLayout>
