---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteData } from "../data/site";
import { publications } from "../data/publications";
import { newsItems } from "../data/news";
import { peopleData } from "../data/people";
import { formatMonthYear, groupPeople, homepageProofOnly, leadPublication, limitItems, withBase } from "../lib/content";

const homepageProof = homepageProofOnly(publications);
const leadPaper = leadPublication(publications) ?? homepageProof[0];
const supportingPapers = homepageProof.filter((item) => item.title !== leadPaper?.title).slice(0, 2);
const isHmsCoverage = (item: (typeof newsItems)[number]) => item.category === "Institutional coverage";
const homepageUpdates = limitItems(newsItems.filter((item) => (item.homepageEligible ?? true) && isHmsCoverage(item)), 1);
const currentRecord = [
  ...supportingPapers.map((item) => ({
    kind: "Paper",
    date: item.publishedAt ?? `${item.year}-01-01`,
    label: [item.journal, item.publishedAt ? formatMonthYear(item.publishedAt) : item.year].filter(Boolean).join(" · "),
    title: item.title,
    summary: item.significanceLine ?? item.summary,
    href: item.link,
    actionLabel: "Read paper"
  })),
  ...homepageUpdates.map((item) => ({
    kind: "HMS",
    date: item.date,
    label: `${formatMonthYear(item.date)} · ${item.category}`,
    title: item.title,
    summary: item.summary,
    href: item.link,
    actionLabel: item.linkLabel ?? "Read coverage"
  }))
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const groupedPeople = groupPeople(peopleData.currentMembers);
const leadership = groupedPeople.find((group) => group.label === "Leadership");
const postdocs = groupedPeople.find((group) => group.label === "Postdoctoral Fellows & Instructors");
const students = groupedPeople.find((group) => group.label === "Graduate Students");
const currentMemberCount = peopleData.currentMembers.length;
const heroFigure = siteData.heroFigures[0];
---

<BaseLayout pageClass="page-home" socialImage={heroFigure.image}>
  <section class="home-hero">
    <img
      class="home-hero__image"
      src={withBase(heroFigure.image)}
      alt=""
      aria-hidden="true"
      style={heroFigure.imagePosition ? `--media-position: ${heroFigure.imagePosition};` : undefined}
      loading="eager"
    />
    <div class="home-hero__veil" aria-hidden="true"></div>

    <div class="shell home-hero__inner">
      <div class="home-hero__copy reveal">
        <p class="overline overline--inverse">Harvard Medical School · HHMI</p>
        <h1>{siteData.heroTitle}</h1>
        <p class="home-hero__deck">{siteData.heroDeck}</p>
        <div class="button-row">
          <a class="button button--light" href={withBase("/publications/")}>View publications</a>
          <a class="button button--outline-light" href={withBase("/people/")}>Meet the lab</a>
        </div>
      </div>

      <a class="home-hero__source" href={heroFigure.href} target="_blank" rel="noreferrer">
        <span>{heroFigure.label}</span>
        <strong>{heroFigure.title}</strong>
      </a>
    </div>
  </section>

  <section class="endorsement-band" aria-label="Institutional affiliations">
    <div class="shell endorsement-band__inner">
      <div class="endorsement-band__copy reveal">
        <p class="overline">Institutional affiliation</p>
        <p class="endorsement-band__title">{siteData.institutionTitle}</p>
        <p>{siteData.institutionSummary}</p>
      </div>
      <div class="endorsement-band__marks">
        {siteData.affiliations.map((affiliation) => (
          <a href={affiliation.href} target="_blank" rel="noreferrer" aria-label={affiliation.name}>
            <img src={withBase(affiliation.logo)} alt={affiliation.alt} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  {leadPaper && (
    <section class="section lead-paper">
      <div class="shell section-intro section-intro--wide reveal">
        <p class="overline">Lead paper · {leadPaper.journal} · {leadPaper.year}</p>
        <h2>How HSV-1 replication machinery assembles—and how inhibitors stop it.</h2>
      </div>

      <div class="shell lead-paper__grid">
        <article class="lead-paper__body reveal">
          <h3>{leadPaper.title}</h3>
          <p class="lead-paper__summary">{leadPaper.summary}</p>
          <p class="citation-text">{leadPaper.citation}</p>
          <div class="button-row">
            <a class="button button--primary" href={leadPaper.link} target="_blank" rel="noreferrer">Read in {leadPaper.journal}</a>
            {leadPaper.coverageLinks?.[0] && (
              <a class="button button--secondary" href={leadPaper.coverageLinks[0]} target="_blank" rel="noreferrer">HMS coverage</a>
            )}
          </div>
        </article>

        <aside class="lead-paper__signal reveal" aria-label="Lead paper details">
          <p class="lead-paper__system">{leadPaper.system}</p>
          <dl>
            <div>
              <dt>Mechanism</dt>
              <dd>Helicase-primase inhibition</dd>
            </div>
            <div>
              <dt>Assembly</dt>
              <dd>Replication fork complex</dd>
            </div>
            <div>
              <dt>Methods</dt>
              <dd>{leadPaper.methodCluster}</dd>
            </div>
            {leadPaper.pmid && (
              <div>
                <dt>PubMed</dt>
                <dd>{leadPaper.pmid}</dd>
              </div>
            )}
          </dl>
        </aside>
      </div>
    </section>
  )}

  <section class="section evidence-section">
    <div class="shell section-intro reveal">
      <p class="overline">Current record</p>
      <h2>Recent work and institutional coverage.</h2>
    </div>

    <div class="shell evidence-list">
      {currentRecord.map((item, index) => (
        <article class="evidence-row reveal">
          <p class="evidence-row__number">{String(index + 1).padStart(2, "0")}</p>
          <div class="evidence-row__meta">
            <span>{item.kind}</span>
            <p>{item.label}</p>
          </div>
          <div class="evidence-row__body">
            <h3><a href={item.href} target="_blank" rel="noreferrer">{item.title}</a></h3>
            {item.summary && <p>{item.summary}</p>}
          </div>
          <a class="arrow-link" href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.actionLabel}: ${item.title}`}>
            <span>{item.actionLabel}</span><span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section team-signal">
    <div class="shell team-signal__grid">
      {leadership?.entries[0] && (
        <div class="team-signal__portrait reveal" style={leadership.entries[0].imagePosition ? `--media-position: ${leadership.entries[0].imagePosition};` : undefined}>
          <img src={withBase(leadership.entries[0].image)} alt={leadership.entries[0].imageAlt} loading="lazy" />
        </div>
      )}

      <div class="team-signal__body reveal">
        <p class="overline">The laboratory</p>
        <h2>Led by Jonathan Abraham at Harvard Medical School and HHMI.</h2>
        <p>The lab includes postdoctoral fellows, instructors, graduate students, and staff working across structural biology and virology.</p>
        <div class="button-row">
          <a class="button button--primary" href={withBase("/people/")}>Meet the lab</a>
          <a class="button button--secondary" href={withBase("/jonathan-abraham/")}>Jonathan Abraham</a>
        </div>
      </div>

      <dl class="team-signal__facts reveal">
        <div><dt>{currentMemberCount}</dt><dd>Current members</dd></div>
        <div><dt>{postdocs?.entries.length ?? 0}</dt><dd>Fellows and instructors</dd></div>
        <div><dt>{students?.entries.length ?? 0}</dt><dd>Graduate students</dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>
