---
import { siteData } from "../data/site";

interface Props {
  eyebrow?: string;
  mode?: "contact";
}

const { eyebrow = "Campus map", mode = "contact" } = Astro.props;
---

<aside class:list={["map-widget", `map-widget--${mode}`, "reveal"]}>
  <div class="map-widget__media">
    <iframe
      class="map-widget__iframe"
      title="Google map of Veritas Science Center at Harvard Medical School"
      src={siteData.contact.mapEmbedUrl}
      loading="eager"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
    <div class="map-widget__location">
      <span>Harvard Longwood campus</span>
      <strong>{siteData.contact.mapBuilding}</strong>
    </div>
  </div>

  <div class="map-widget__body">
    <p class="overline">{eyebrow}</p>
    <a class="arrow-link" href={siteData.contact.mapUrl} target="_blank" rel="noreferrer"><span>Open in Google Maps</span><span aria-hidden="true">↗</span></a>
  </div>
</aside>
