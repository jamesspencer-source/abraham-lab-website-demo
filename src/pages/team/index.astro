---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { peopleData } from "../../data/people";
import { groupPeople, withBase } from "../../lib/content";

const groupedPeople = groupPeople(peopleData.currentMembers);
const totalAlumni = peopleData.alumni.reduce((total, group) => total + group.entries.length, 0);
const anchorFor = (label: string) =>
  label.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const monthNames = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December"
];
const formatLabMonth = (value: string) => {
  const [year, month] = value.split("-");
  return `${monthNames[Number(month) - 1]} ${year}`;
};
const formatLabDates = (entry: { labStart?: string; labEnd?: string }) => {
  if (entry.labStart && entry.labEnd) {
    return `${formatLabMonth(entry.labStart)} - ${formatLabMonth(entry.labEnd)}`;
  }
  if (entry.labStart) {
    return `Joined ${formatLabMonth(entry.labStart)}`;
  }
  if (entry.labEnd) {
    return `Left ${formatLabMonth(entry.labEnd)}`;
  }
  return null;
};
const directoryIndex = [
  ...groupedPeople.map((group) => ({ label: group.label, count: group.entries.length, id: anchorFor(group.label) })),
  { label: "Summer 2026", count: peopleData.seasonalMembers.length, id: "summer-2026" },
  { label: "Alumni", count: totalAlumni, id: "alumni" }
];
---

<BaseLayout title="Team" description="Current members and alumni of the Abraham Lab.">
  <section class="page-intro page-intro--people">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <p class="overline">Team</p>
        <h1>The Abraham Lab.</h1>
        <p>Faculty, fellows, students, and staff at Harvard Medical School.</p>
      </div>
    </div>
  </section>

  <nav class="directory-nav" aria-label="Team directory sections">
    <div class="shell directory-nav__inner">
      {directoryIndex.map((item) => (
        <a href={`#${item.id}`}><span>{item.label}</span><strong>{item.count}</strong></a>
      ))}
    </div>
  </nav>

  <div class="section shell team-directory">
    {groupedPeople.map((group) => (
      <section class="team-directory__group" id={anchorFor(group.label)}>
        <header class="team-directory__group-header reveal">
          <h2>{group.label}</h2>
          <p>{String(group.entries.length).padStart(2, "0")}</p>
        </header>

        <div class="team-directory__table" role="list">
          <div class="team-directory__labels" aria-hidden="true">
            <span>Name</span>
            <span>Role</span>
            <span>Details</span>
          </div>
          {group.entries.map((person) => (
            <article class="team-directory__row reveal" role="listitem">
              <div class="team-directory__identity">
                <span class="team-directory__mobile-label">Name</span>
                <h3>{person.name}</h3>
                {group.label === "Leadership" && (
                  <a href={withBase("/jonathan-abraham/")}>View profile <span aria-hidden="true">↗</span></a>
                )}
              </div>
              <div class="team-directory__role">
                <span class="team-directory__mobile-label">Role</span>
                <p>{person.title}</p>
              </div>
              {(person.programTags?.length || person.fellowships?.length || person.labStart || person.labEnd) && (
                <div class="team-directory__affiliations">
                  {person.programTags?.map((tag) => <p><span>Program</span>{tag}</p>)}
                  {person.fellowships?.map((fellowship) => <p><span>Fellowship</span>{fellowship}</p>)}
                  {formatLabDates(person) && <p><span>Lab</span>{formatLabDates(person)}</p>}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="section seasonal-register" id="summer-2026">
    <div class="shell team-directory__group">
      <header class="team-directory__group-header reveal">
        <div>
          <p class="overline">Summer 2026</p>
          <h2>Summer researchers</h2>
        </div>
        <p>{String(peopleData.seasonalMembers.length).padStart(2, "0")}</p>
      </header>

      <div class="team-directory__table" role="list">
        <div class="team-directory__labels" aria-hidden="true">
          <span>Name</span>
          <span>Role</span>
          <span>Details</span>
        </div>
        {peopleData.seasonalMembers.map((person) => (
          <article class="team-directory__row reveal" role="listitem">
            <div class="team-directory__identity">
              <span class="team-directory__mobile-label">Name</span>
              <h3>{person.name}</h3>
            </div>
            <div class="team-directory__role">
              <span class="team-directory__mobile-label">Role</span>
              <p>{person.title}</p>
            </div>
            {(person.program || person.labStart || person.labEnd) && (
              <div class="team-directory__affiliations">
                {person.program && <p><span>Program</span>{person.program}</p>}
                {formatLabDates(person) && <p><span>Lab</span>{formatLabDates(person)}</p>}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alumni-register" id="alumni">
    <div class="shell section-intro reveal">
      <h2>Alumni</h2>
    </div>
    <div class="shell alumni-register__grid">
      {peopleData.alumni.map((group) => (
        <section class="alumni-column reveal">
          <h3>{group.label}</h3>
          <ul>
            {group.entries.map((entry) => (
              <li>
                <span>{entry.name}</span>
                {formatLabDates(entry) && <small class="alumni-column__dates">{formatLabDates(entry)}</small>}
                {entry.destination && <small>{entry.destination}</small>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
