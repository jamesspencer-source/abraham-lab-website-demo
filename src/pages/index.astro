---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteData } from "../data/site";
import { publications } from "../data/publications";
import { newsItems } from "../data/news";
import { peopleData } from "../data/people";
import { groupPeople, homepageProofOnly, leadPublication, withBase } from "../lib/content";

const homepageProof = homepageProofOnly(publications);
const recentPaper = leadPublication(publications) ?? homepageProof[0];
const labFilm = newsItems.find((item) => item.link.includes("GFM3KLZCDps"));
const groupedPeople = groupPeople(peopleData.currentMembers);
const leadership = groupedPeople.find((group) => group.label === "Leadership");
const heroFigure = siteData.heroFigures[0];
---

<BaseLayout pageClass="page-home" socialImage={heroFigure.image}>
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy reveal">
        <p class="overline overline--inverse">Harvard Medical School · HHMI</p>
        <h1>{siteData.heroTitle}</h1>
        <p class="home-hero__deck">{siteData.heroDeck}</p>
        <div class="button-row">
          <a class="button button--light" href={withBase("/publications/")}>View publications</a>
          <a class="button button--outline-light" href={withBase("/people/")}>Meet the lab</a>
        </div>
      </div>

      <a class="home-hero__figure reveal" href={heroFigure.href} target="_blank" rel="noreferrer">
        <figure>
          <div class="home-hero__figure-plate">
            <img src={withBase(heroFigure.image)} alt={heroFigure.alt} loading="eager" />
          </div>
          <figcaption>
            <span>{heroFigure.label}</span>
            <strong>{heroFigure.title}</strong>
            <span aria-hidden="true">↗</span>
          </figcaption>
        </figure>
      </a>
    </div>
  </section>

  <section class="endorsement-band" aria-label="Institutional affiliations">
    <div class="shell endorsement-band__inner">
      <div class="endorsement-band__copy reveal">
        <p class="overline">Institutional affiliation</p>
        <p class="endorsement-band__title">{siteData.institutionTitle}</p>
        <p>{siteData.institutionSummary}</p>
      </div>
      <div class="endorsement-band__marks">
        {siteData.affiliations.map((affiliation) => (
          <a href={affiliation.href} target="_blank" rel="noreferrer" aria-label={affiliation.name}>
            <img src={withBase(affiliation.logo)} alt={affiliation.alt} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  {recentPaper && (
    <section class="section lead-paper">
      <div class="shell section-intro section-intro--wide reveal">
        <p class="overline">Recent paper · {recentPaper.journal} · {recentPaper.year}</p>
        <h2>{recentPaper.significanceLine}</h2>
      </div>

      <div class="shell lead-paper__grid">
        <article class="lead-paper__body reveal">
          <h3>{recentPaper.title}</h3>
          <p class="lead-paper__summary">{recentPaper.summary}</p>
          <p class="citation-text">{recentPaper.citation}</p>
          <div class="button-row">
            <a class="button button--primary" href={recentPaper.link} target="_blank" rel="noreferrer">Read in {recentPaper.journal}</a>
            {recentPaper.coverageLinks?.[0] && (
              <a class="button button--secondary" href={recentPaper.coverageLinks[0]} target="_blank" rel="noreferrer">HMS coverage</a>
            )}
          </div>
        </article>

        <aside class="lead-paper__signal reveal" aria-label="Recent paper details">
          <p class="lead-paper__system">{recentPaper.system}</p>
          <dl>
            <div>
              <dt>Source</dt>
              <dd>{recentPaper.journal === "bioRxiv" ? "Preprint" : recentPaper.journal}</dd>
            </div>
            <div>
              <dt>Methods</dt>
              <dd>{recentPaper.methodCluster}</dd>
            </div>
            {recentPaper.doi && (
              <div>
                <dt>DOI</dt>
                <dd>{recentPaper.doi}</dd>
              </div>
            )}
          </dl>
        </aside>
      </div>
    </section>
  )}

  <section class="section team-signal">
    <div class="shell team-signal__grid">
      {leadership?.entries[0] && (
        <div class="team-signal__portrait reveal" style={leadership.entries[0].imagePosition ? `--media-position: ${leadership.entries[0].imagePosition};` : undefined}>
          <img src={withBase(leadership.entries[0].image)} alt={leadership.entries[0].imageAlt} loading="lazy" />
        </div>
      )}

      <div class="team-signal__body reveal">
        <p class="overline">The laboratory</p>
        <h2>Jonathan Abraham leads a team across structural biology and virology.</h2>
        <p>Jonathan is Professor of Microbiology at Harvard Medical School and an Investigator of the Howard Hughes Medical Institute.</p>
        <div class="button-row">
          <a class="button button--primary" href={withBase("/people/")}>Meet the lab</a>
          <a class="button button--secondary" href={withBase("/jonathan-abraham/")}>Jonathan Abraham</a>
        </div>
      </div>

      {labFilm && (
        <a class="team-signal__film reveal" href={labFilm.link} target="_blank" rel="noreferrer">
          <span class="overline">HMS film</span>
          <strong>{labFilm.title}</strong>
          <span>{labFilm.linkLabel ?? "Watch film"} <span aria-hidden="true">↗</span></span>
        </a>
      )}
    </div>
  </section>
</BaseLayout>
