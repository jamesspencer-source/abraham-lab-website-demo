---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publications } from "../../data/publications";
import { groupPublicationsByYear } from "../../lib/content";
import { siteData } from "../../data/site";

const groupedPublications = groupPublicationsByYear(publications);
---

<BaseLayout
  title="Publications"
  description="Papers from the Abraham Lab."
  socialImage={siteData.heroFigures[0].image}
>
  <section class="page-intro page-intro--publications">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <p class="overline">Selected publications</p>
        <h1>Publications</h1>
      </div>
    </div>
  </section>

  <section class="publication-record" aria-label="Publication record">
    <div class="shell publication-record__list">
      {groupedPublications.map((yearGroup) => (
        <section class="publication-year" aria-labelledby={`publications-${yearGroup.year}`}>
          <h2 id={`publications-${yearGroup.year}`}>{yearGroup.year}</h2>
          <ol>
            {yearGroup.entries.map((item) => (
              <li class="publication-row reveal">
                <div class="publication-row__body">
                  <h3><a href={item.link} target="_blank" rel="noreferrer">{item.title}</a></h3>
                  <p class="publication-row__citation">{item.citation}</p>
                </div>
                <div class="publication-row__meta">
                  <span>{item.articleType}</span>
                  {item.journal && <span>{item.journal}</span>}
                  {item.doi && <a href={`https://doi.org/${item.doi}`} target="_blank" rel="noreferrer">DOI</a>}
                  {item.pmid && <a href={`https://pubmed.ncbi.nlm.nih.gov/${item.pmid}/`} target="_blank" rel="noreferrer">PMID</a>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
