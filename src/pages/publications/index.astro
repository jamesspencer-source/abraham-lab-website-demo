---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publications } from "../../data/publications";
import { groupPublicationsByYear } from "../../lib/content";

const groupedPublications = groupPublicationsByYear(publications);
---

<BaseLayout title="Publications" description="Peer-reviewed papers and preprints from the Abraham Lab.">
  <section class="page-intro page-intro--publications">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <h1>Publications.</h1>
        <p>Peer-reviewed papers and preprints from the Abraham Lab.</p>
      </div>
    </div>
  </section>

  <section class="section archive-section" aria-label="Publication record">
    <div class="shell archive-list">
      {groupedPublications.map((yearGroup) => (
        <section class="archive-year reveal" aria-labelledby={`publications-${yearGroup.year}`}>
          <h2 id={`publications-${yearGroup.year}`}>{yearGroup.year}</h2>
          <ol>
            {yearGroup.entries.map((item) => (
              <li>
                <div>
                  <a href={item.link} target="_blank" rel="noreferrer">{item.title}</a>
                  <p>{item.citation}</p>
                </div>
                {(item.journal || item.pmid) && (
                  <p class="archive-year__meta">
                    {[item.journal, item.pmid ? `PMID ${item.pmid}` : undefined].filter(Boolean).join(" · ")}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
