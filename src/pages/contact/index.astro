---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MapWidget from "../../components/MapWidget.astro";
import { siteData } from "../../data/site";
---

<BaseLayout title="Contact" description="Contact information for the Abraham Lab." socialImage="/assets/images/location/hms-map-tile-1.png">
  <section class="page-intro page-intro--contact">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <p class="overline">Contact</p>
        <h1>Contact the Abraham Lab.</h1>
        <p>For collaborations, speaking requests, and administrative inquiries.</p>
      </div>
    </div>
  </section>

  <section class="section contact-page">
    <div class="shell contact-page__grid">
      <div class="contact-page__details reveal">
        <section class="contact-block">
          <p class="overline">Principal investigator</p>
          <h2>Jonathan Abraham</h2>
          <a href={`mailto:${siteData.contact.email}`}>{siteData.contact.email}</a>
        </section>
        <section class="contact-block">
          <p class="overline">Laboratory operations</p>
          <h2>James Spencer</h2>
          <a href={`mailto:${siteData.contact.managerEmail}`}>{siteData.contact.managerEmail}</a>
        </section>
        <section class="contact-block">
          <p class="overline">Address</p>
          {siteData.contact.addressLines.map((line) => <p>{line}</p>)}
        </section>
        <section class="contact-block">
          <p class="overline">Affiliations</p>
          <ul>
            {siteData.affiliations.map((affiliation) => (
              <li><a class="arrow-link" href={affiliation.href} target="_blank" rel="noreferrer"><span>{affiliation.shortName ?? affiliation.name}</span><span aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </section>
      </div>
      <MapWidget mode="contact" eyebrow="Campus map" />
    </div>
  </section>
</BaseLayout>
