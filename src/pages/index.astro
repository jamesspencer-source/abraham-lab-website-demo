---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteData } from "../data/site";
import { publications } from "../data/publications";
import { newsItems } from "../data/news";
import { homepageProofOnly, leadPublication, withBase } from "../lib/content";

const proofPapers = homepageProofOnly(publications);
const recentPaper = leadPublication(publications) ?? proofPapers[0];
const otherRecentPapers = proofPapers.filter((item) => item.title !== recentPaper?.title).slice(0, 2);
const hmsCoverage = newsItems.find((item) => item.category === "Institutional coverage");
const labFilm = newsItems.find((item) => item.link.includes("GFM3KLZCDps"));
const heroFigure = siteData.heroFigures[0];
---

<BaseLayout pageClass="page-home" socialImage={heroFigure.image}>
  <section class="dossier-hero home-hero">
    <div class="shell dossier-hero__grid">
      <div class="dossier-hero__copy reveal">
        <p class="overline overline--inverse">Harvard Medical School · HHMI</p>
        <h1>{siteData.heroTitle}</h1>
        <p class="dossier-hero__deck">{siteData.heroDeck}</p>
        <div class="button-row">
          <a class="button button--light" href={withBase("/publications/")}>View publications</a>
          <a class="button button--outline-light" href={withBase("/team/")}>View the team</a>
        </div>
      </div>

      <figure class="dossier-hero__figure reveal">
        <a href={heroFigure.href} target="_blank" rel="noreferrer">
          <img src={withBase(heroFigure.image)} alt={heroFigure.alt} loading="eager" fetchpriority="high" />
        </a>
        <figcaption>
          <span>{heroFigure.figureCredit}. {heroFigure.figureNumber}. {heroFigure.license}.</span>
          <a href={heroFigure.visualSource} target="_blank" rel="noreferrer">View source <span aria-hidden="true">↗</span></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="endorsement-band" aria-label="Institutional affiliations">
    <div class="shell endorsement-band__inner">
      <p class="endorsement-band__title">{siteData.institutionTitle}</p>
      <div class="endorsement-band__marks">
        {siteData.affiliations.map((affiliation) => (
          <a href={affiliation.href} target="_blank" rel="noreferrer" aria-label={affiliation.name}>
            <img src={withBase(affiliation.logo)} alt={affiliation.alt} />
          </a>
        ))}
      </div>
    </div>
  </section>

  {recentPaper && (
    <section class="section publication-feature">
      <div class="shell publication-feature__grid">
        <header class="publication-feature__heading reveal">
          <p class="overline">Recent paper · {recentPaper.articleType}</p>
          <p class="publication-feature__source">{recentPaper.journal} · {recentPaper.year}</p>
        </header>
        <article class="publication-feature__body reveal">
          <h2>{recentPaper.title}</h2>
          <p class="publication-feature__claim">{recentPaper.significanceLine}</p>
          <p>{recentPaper.summary}</p>
          <p class="citation-text">{recentPaper.citation}</p>
          <div class="button-row">
            <a class="button button--primary" href={recentPaper.link} target="_blank" rel="noreferrer">Read paper</a>
            <a class="text-link" href={withBase("/publications/")}>Complete publication record <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <dl class="publication-feature__facts reveal">
          {recentPaper.system && <div><dt>System</dt><dd>{recentPaper.system}</dd></div>}
          {recentPaper.methodCluster && <div><dt>Methods</dt><dd>{recentPaper.methodCluster}</dd></div>}
          {recentPaper.doi && <div><dt>DOI</dt><dd>{recentPaper.doi}</dd></div>}
        </dl>
      </div>
    </section>
  )}

  <section class="section current-work">
    <div class="shell current-work__grid">
      <header class="section-heading reveal">
        <p class="overline">Current work</p>
        <h2>Papers and HMS coverage.</h2>
      </header>
      <div class="dossier-ledger">
        {otherRecentPapers.map((paper) => (
          <article class="dossier-ledger__row reveal">
            <p class="dossier-ledger__meta">{paper.journal} · {paper.year}</p>
            <h3><a href={paper.link} target="_blank" rel="noreferrer">{paper.title}</a></h3>
            <p>{paper.significanceLine}</p>
            <span class="dossier-ledger__action" aria-hidden="true">↗</span>
          </article>
        ))}
        {hmsCoverage && (
          <article class="dossier-ledger__row reveal">
            <p class="dossier-ledger__meta">{hmsCoverage.source}</p>
            <h3><a href={hmsCoverage.link} target="_blank" rel="noreferrer">{hmsCoverage.title}</a></h3>
            <p>{hmsCoverage.summary}</p>
            <span class="dossier-ledger__action" aria-hidden="true">↗</span>
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="section team-signal">
    <div class="shell team-signal__grid">
      <div class="team-signal__body reveal">
        <p class="overline">Jonathan Abraham</p>
        <h2>Professor of Microbiology and HHMI Investigator.</h2>
        <p>Jonathan leads a team of virologists, structural biologists, fellows, students, and research staff at Harvard Medical School.</p>
        <div class="button-row">
          <a class="button button--primary" href={withBase("/jonathan-abraham/")}>View profile</a>
          <a class="button button--secondary" href={withBase("/team/")}>View the team</a>
        </div>
      </div>

      {labFilm && (
        <a class="team-signal__film reveal" href={labFilm.link} target="_blank" rel="noreferrer">
          <span class="overline">Inside the Labs of HMS</span>
          <strong>{labFilm.title}</strong>
          <span>{labFilm.linkLabel ?? "Watch film"} <span aria-hidden="true">↗</span></span>
        </a>
      )}
    </div>
  </section>
</BaseLayout>
