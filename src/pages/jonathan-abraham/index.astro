---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { jonathanProfile } from "../../data/jonathan";
import { publications } from "../../data/publications";
import { withBase } from "../../lib/content";

const selectedPapers = jonathanProfile.representativeWork
  .map((title) => publications.find((item) => item.title === title))
  .filter(Boolean);
---

<BaseLayout title="Jonathan Abraham" description="Profile of Jonathan Abraham, MD, PhD.">
  <section class="profile-masthead">
    <div class="shell profile-masthead__grid">
      <div class="profile-masthead__copy reveal">
        <p class="overline">Principal investigator</p>
        <h1>{jonathanProfile.name}</h1>
        <p class="profile-masthead__title">{jonathanProfile.title}</p>
        <p class="profile-masthead__title">{jonathanProfile.secondaryTitle}</p>
        <p class="profile-masthead__overview">{jonathanProfile.overview}</p>
        <div class="button-row">
          <a class="button button--primary" href={withBase("/publications/")}>View publications</a>
          <a class="button button--secondary" href={withBase("/contact/")}>Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="appointment-band">
    <div class="shell appointment-band__inner">
      {jonathanProfile.appointments.map((item) => (
        <div class="appointment-band__item">
          <p class="overline">{item.label}</p>
          <p>{item.title}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section profile-story">
    <div class="shell profile-story__grid">
      <article class="profile-story__body reveal">
        <p class="overline">Biography</p>
        {jonathanProfile.biography.map((paragraph) => <p>{paragraph}</p>)}
      </article>

      <aside class="profile-story__rail">
        <section class="profile-list reveal">
          <p class="overline">Distinctions</p>
          <ul>
            {jonathanProfile.distinctions.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="profile-list reveal">
          <p class="overline">Research focus</p>
          <ul>
            {jonathanProfile.focusAreas.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="profile-list reveal">
          <p class="overline">Selected work</p>
          <ul>
            {selectedPapers.map((item) => item && (
              <li><a href={item.link} target="_blank" rel="noreferrer">{item.title}</a></li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>
