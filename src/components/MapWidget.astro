---
import { siteData } from "../data/site";

interface Props {
  eyebrow?: string;
}

const { eyebrow = "Campus map" } = Astro.props;
---

<aside class="map-widget reveal" aria-label={eyebrow} data-map-widget>
  <div class="map-widget__body">
    <div>
      <p class="overline">{eyebrow}</p>
      <strong>{siteData.contact.mapBuilding}</strong>
    </div>
    <div class="map-widget__actions">
      <button class="map-widget__toggle" type="button" aria-expanded="false" aria-controls="campus-map" data-map-src={siteData.contact.mapEmbedUrl} hidden>Show map</button>
      <a class="text-link" href={siteData.contact.mapUrl} target="_blank" rel="noreferrer">Open in Google Maps <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div id="campus-map" class="map-widget__media" hidden></div>
</aside>

<script>
  document.querySelectorAll<HTMLElement>("[data-map-widget]").forEach((widget) => {
    const toggle = widget.querySelector<HTMLButtonElement>(".map-widget__toggle");
    const media = widget.querySelector<HTMLElement>(".map-widget__media");
    const source = toggle?.dataset.mapSrc;
    if (!toggle || !media || !source) return;

    toggle.addEventListener("click", () => {
      const showMap = media.hidden;
      if (showMap) {
        const frame = document.createElement("iframe");
        frame.className = "map-widget__iframe";
        frame.title = "Google map of Veritas Science Center at Harvard Medical School";
        frame.src = source;
        frame.referrerPolicy = "no-referrer-when-downgrade";
        frame.allowFullscreen = true;
        media.replaceChildren(frame);
      } else {
        media.replaceChildren();
      }
      media.hidden = !showMap;
      toggle.setAttribute("aria-expanded", String(showMap));
      toggle.textContent = showMap ? "Hide map" : "Show map";
    });

    toggle.hidden = false;
  });
</script>
