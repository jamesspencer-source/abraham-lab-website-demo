---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MapWidget from "../../components/MapWidget.astro";
import { siteData } from "../../data/site";
---

<BaseLayout title="Contact" description="Contact information and location for the Abraham Lab.">
  <section class="page-intro page-intro--utility">
    <div class="shell page-intro__grid">
      <div class="page-intro__copy reveal">
        <p class="overline">Abraham Lab</p>
        <h1>Contact</h1>
        <p>For scientific, speaking, and administrative inquiries.</p>
      </div>
    </div>
  </section>

  <section class="contact-page">
    <div class="shell contact-page__grid">
      <div class="contact-page__details">
        <section class="contact-block reveal">
          <p class="overline">Scientific correspondence</p>
          <h2>Jonathan Abraham</h2>
          <a href={`mailto:${siteData.contact.email}`}>{siteData.contact.email}</a>
        </section>
        <section class="contact-block reveal">
          <p class="overline">Administration</p>
          <h2>James Spencer</h2>
          <a href={`mailto:${siteData.contact.managerEmail}`}>{siteData.contact.managerEmail}</a>
        </section>
        <section class="contact-block reveal">
          <p class="overline">Location</p>
          <address>{siteData.contact.addressLines.map((line) => <span>{line}</span>)}</address>
        </section>
      </div>
      <MapWidget eyebrow="Campus map" />
    </div>

  </section>
</BaseLayout>
